# FRC Team Portal — example environment configuration.
# Copy to .env (backend) and frontend/.env.local (frontend) and fill in.
# NEVER commit real secrets to the repository.

# Backend (application.py)
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///frc_portal.db
TOKEN_TTL_SECONDS=43200
# Comma-separated list of allowed frontend origins for API CORS (dev only):
FLASK_CORS_ORIGINS=http://localhost:5173

# Frontend (frontend/.env.local)
# Base URL of the API; leave empty to use same-origin /api requests.
VITE_API_BASE_URL=
